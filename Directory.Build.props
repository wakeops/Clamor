<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Lets the WPF/XAML-free projects in this solution build on non-Windows dev machines/CI; the
         Windows-only ones (audio engine, hotkeys, the WPF app itself) still only function at
         runtime on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
