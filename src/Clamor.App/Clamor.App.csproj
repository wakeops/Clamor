<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon (system tray) has no first-party WPF equivalent; System.Windows.Forms provides it. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Clamor.App</RootNamespace>
    <AssemblyName>Clamor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\clamor.ico</ApplicationIcon>
    <Authors>Clamor</Authors>
    <Product>Clamor</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Windows.Forms is only used by TrayIconService (explicit using there); the implicit
         global using otherwise collides with System.Windows types of the same name (Application, etc.). -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\clamor.ico" />
    <Resource Include="Assets\clamor-text-cropped.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clamor.Core\Clamor.Core.csproj" />
    <ProjectReference Include="..\Clamor.Audio\Clamor.Audio.csproj" />
    <ProjectReference Include="..\Clamor.Hotkeys\Clamor.Hotkeys.csproj" />
  </ItemGroup>

</Project>
