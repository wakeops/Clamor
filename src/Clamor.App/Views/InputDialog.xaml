<Window x:Class="Clamor.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Clamor.App.Views.Controls"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}">
    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top"/>
        <StackPanel Margin="20">
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBox x:Name="InputBox" Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
                <Button Content="OK" Style="{StaticResource PrimaryButtonStyle}" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
