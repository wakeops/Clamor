<UserControl x:Class="Clamor.App.Views.SoundGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Background="{StaticResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
            <ItemsControl ItemsSource="{Binding Clips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource SoundButtonStyle}"
                                Width="160" Height="130" Margin="8"
                                Command="{Binding DataContext.PlayClipCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0" Content="&#10005;" ToolTip="Remove"
                                        Style="{StaticResource IconButtonStyle}"
                                        Width="20" Height="20" FontSize="9" HorizontalAlignment="Right"
                                        Command="{Binding DataContext.RemoveClipCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>

                                <TextBlock Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"
                                           MouseLeftButtonDown="ClipName_MouseLeftButtonDown"/>

                                <StackPanel Grid.Row="2">
                                    <Slider Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" Margin="6,0,6,2"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                        <Button Content="{Binding HotkeyDisplay}" Style="{StaticResource LinkButtonStyle}"
                                                FontSize="11"
                                                Command="{Binding DataContext.AssignHotkeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="&#10005;" Style="{StaticResource LinkButtonStyle}"
                                                FontSize="9" Margin="4,0,0,0" ToolTip="Clear hotkey"
                                                Visibility="{Binding HasHotkey, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.ClearHotkeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
