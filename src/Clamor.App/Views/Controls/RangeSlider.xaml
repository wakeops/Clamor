<UserControl x:Class="Clamor.App.Views.Controls.RangeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Canvas is inset by half a thumb on each side so both thumbs can sit fully on-track at
         the extremes; RangeSlider.xaml.cs positions everything inside it. -->
    <Grid x:Name="Root" Height="24" Background="Transparent" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border Height="4" CornerRadius="2" Background="{StaticResource BorderBrush}"
                VerticalAlignment="Center" Margin="7,0"/>
        <Canvas x:Name="TrackCanvas" Margin="7,0" SizeChanged="TrackCanvas_SizeChanged">
            <Border x:Name="SelectedRange" Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}"
                    Canvas.Top="10" IsHitTestVisible="False"/>
            <Thumb x:Name="LowerThumb" Style="{StaticResource FlatSliderThumbStyle}" Cursor="Hand"
                   Canvas.Top="5" DragDelta="LowerThumb_DragDelta"/>
            <Thumb x:Name="UpperThumb" Style="{StaticResource FlatSliderThumbStyle}" Cursor="Hand"
                   Canvas.Top="5" DragDelta="UpperThumb_DragDelta"/>
        </Canvas>
    </Grid>
</UserControl>
