<Window x:Class="Clamor.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Clamor.App.Views.Controls"
        Title="Settings" Width="480" SizeToContent="Height" MaxHeight="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource SurfaceBrush}">
        <StackPanel Margin="24">

            <TextBlock Text="Audio Devices" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Virtual cable output (what others hear)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding OutputDevices}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedCableDevice}" Margin="0,0,0,12"/>

            <TextBlock Text="Monitor output (what you hear)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding OutputDevices}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedMonitorDevice}" Margin="0,0,0,12"/>

            <TextBlock Text="Microphone input" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding InputDevices}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedInputDevice}" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Mic passthrough" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding MicPassthroughEnabled}"/>
            </StackPanel>

            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16"/>

            <StackPanel Visibility="{Binding IsVbCableInstalled, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="VB-Audio Virtual Cable is installed." Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding IsVbCableMissing, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="VB-Audio Virtual Cable was not detected." TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Button Content="Get VB-Audio Virtual Cable" Style="{StaticResource LinkButtonStyle}"
                        Command="{Binding OpenVbCablePageCommand}" HorizontalAlignment="Left"/>
            </StackPanel>

            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16"/>

            <TextBlock Text="General" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Minimize to tray on close" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding MinimizeToTrayOnClose}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Stop-all hotkey:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding StopAllHotkeyDisplay}" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="Set" Command="{Binding AssignStopAllHotkeyCommand}" Margin="0,0,4,0"/>
                <Button Content="Clear" Command="{Binding ClearStopAllHotkeyCommand}"/>
            </StackPanel>

            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16"/>

            <Button Content="Close" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Click="Close_Click"/>

        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
