<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon (system tray) has no first-party WPF equivalent; System.Windows.Forms provides it. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Clamor.App</RootNamespace>
    <AssemblyName>Clamor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Authors>Clamor</Authors>
    <Product>Clamor</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clamor.Core\Clamor.Core.csproj" />
    <ProjectReference Include="..\Clamor.Audio\Clamor.Audio.csproj" />
    <ProjectReference Include="..\Clamor.Hotkeys\Clamor.Hotkeys.csproj" />
  </ItemGroup>

</Project>
