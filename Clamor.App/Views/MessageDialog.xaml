<Window x:Class="Clamor.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SecondaryButton" Content="Cancel" Margin="0,0,8,0"
                    Click="SecondaryButton_Click" Visibility="Collapsed" IsCancel="True"/>
            <Button x:Name="PrimaryButton" Content="OK" Style="{StaticResource PrimaryButtonStyle}"
                    Click="PrimaryButton_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
