<Window x:Class="Clamor.App.Views.VbCablePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Audio Cable" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,20"
                   Text="Clamor works best with a virtual audio cable so other apps (Discord, Zoom, games) can hear your clips. Install VB-Audio Virtual Cable now?"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Not Now" Margin="0,0,8,0" Click="NotNow_Click"/>
            <Button Content="Install Now" Style="{StaticResource PrimaryButtonStyle}" Click="Install_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
